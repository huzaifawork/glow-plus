{
  "expo": {
    "name": "Glow+",
    "slug": "glow-plus",
    "owner": "tanoliusman_140",
    "scheme": "glowplus",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.glowplus.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Glow+ uses your location only on this device, to sort nearby salons by distance and show which ones still have appointments today. Your location is never sent to Glow+ or shared with any salon.",
        "NSUserTrackingUsageDescription": "Glow+ does not track you across apps or websites."
      }
    },
    "android": {
      "package": "com.glowplus.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0B0F"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0F"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Glow+ uses your location only on this device, to sort nearby salons by distance. It is never sent to Glow+ or shared with any salon."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E0116F"
        }
      ],
      "expo-splash-screen",
      "expo-web-browser"
    ],
    "extra": {
      "apiBaseUrl": "https://glow-plus-api-six.vercel.app/v1",
      "demoMode": false,
      "supabaseUrl": "https://xhyoeiltwcciqowlwyov.supabase.co",
      "supabaseAnonKey": "sb_publishable_B8HpEIgPMihsQ_6Ges0tew_eMqEp55o",
      "salonTimezone": "America/Toronto",
      "eas": {
        "projectId": "7d3209aa-2788-474a-9848-3475ab0ccbfd"
      }
    }
  }
}
