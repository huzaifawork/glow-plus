# ---- Secrets -------------------------------------------------------------
# .env holds live Stripe + Resend credentials. Never commit it.
.env
# Catch every variant (.env.local, .env.production, .env.bak, .env.save …)
# so a stray backup of a live .env can never become committable.
.env.*
*.pem
*.key

# .env.example IS committed — it must contain placeholders only.
!.env.example

# ---- Dependencies --------------------------------------------------------
node_modules/
.pnp
.pnp.js

# ---- Build output --------------------------------------------------------
dist/
build/
out/
*.tsbuildinfo

# ---- Binaries & archives -------------------------------------------------
# stripe.exe is a 37MB vendored CLI; developers install their own.
stripe.exe
*.zip

# ---- Test / coverage -----------------------------------------------------
coverage/
.nyc_output/
test-results/
playwright-report/

# ---- Logs ----------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Editor & OS ---------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# ---- Misc ----------------------------------------------------------------
.cache/
tmp/
temp/
