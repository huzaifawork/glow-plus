# Copy this file to .env and fill in real values.
#   cp .env.example .env
# .env is gitignored — never commit real credentials.

# ---- Database ------------------------------------------------------------
# Matches docker/docker-compose.yml (postgres on host port 5433).
#   docker compose -f docker/docker-compose.yml up -d postgres
DATABASE_URL="postgresql://glowplus:glowplus@localhost:5433/glowplus?schema=public"

# ---- Server --------------------------------------------------------------
PORT=4000
APP_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000"

# ---- Auth ----------------------------------------------------------------
# Generate one with: openssl rand -base64 48
# Validated at boot (T27): the API refuses to start if this is missing, is a
# placeholder, or is shorter than 32 characters. There is no fallback any more
# — the old `?? 'dev-secret-change-me'` default was [F20] with the safety off.
JWT_SECRET="change-me-to-a-long-random-string"

# ---- Stripe --------------------------------------------------------------
# Dashboard -> Developers -> API keys
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key_here"
# Dashboard -> Product catalogue -> your price IDs
STRIPE_PRICE_ID_MONTHLY="price_your_monthly_price_id_here"   # $49.99/mo
STRIPE_PRICE_ID_ANNUAL="price_your_annual_price_id_here"     # $479.99/yr
# Printed by: stripe listen --forward-to localhost:4000/billing/webhook
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_signing_secret_here"

# ---- Email (Resend) ------------------------------------------------------
# "log" prints emails to stdout; "resend" sends for real.
EMAIL_PROVIDER="log"
RESEND_API_KEY="re_your_resend_api_key_here"
# Until a domain is verified in Resend, the shared onboarding@resend.dev
# sender can only deliver to your own Resend account address.
EMAIL_FROM="Glow+ <onboarding@resend.dev>"

# ---- Rate limiting (T26) -------------------------------------------------
# Whether to trust the X-Forwarded-For header when identifying a caller.
# Leave OFF (0) on anything directly reachable: the header is caller-supplied,
# so trusting it lets an attacker send a fresh value per request and get a new
# rate-limit bucket every time — the limiter still answers 200 and looks fine.
# Turn ON (1) on Vercel / behind any proxy that overwrites it, or every visitor
# shares the proxy's single IP and one abuser locks out the whole platform.
TRUST_PROXY_HEADER=0

# ---- Points (T25) --------------------------------------------------------
# Days a visit counts toward reward progress before it expires. Defaults to 365.
POINTS_EXPIRE_AFTER_DAYS=365

# T31b — AES-256-GCM key for personal data at rest (phone numbers).
# 32 bytes. Generate with: openssl rand -hex 32
ENCRYPTION_KEY="your_32_byte_hex_encryption_key_here"
