// Glow+ — Prisma schema
// Matches the data model in the Glow+ Platform Spec (sections 5, 7.6, 10)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // T52 — TWO urls, and they must not be the same string in production.
  //
  // `url` is the POOLED connection (Supabase transaction mode, :6543). Every
  // serverless invocation gets its own process, so without a pooler in front
  // a modest traffic spike opens hundreds of Postgres connections and the
  // database refuses new ones — the single most common way Prisma-on-Vercel
  // dies (T55). Transaction mode is also why the URL carries
  // `?pgbouncer=true&connection_limit=1`: it does not support prepared
  // statements, which Prisma uses by default.
  //
  // `directUrl` is the UNPOOLED connection (Supabase session mode, :5432) and
  // is used by the CLI only — `migrate deploy`, `migrate dev`, `db pull`. It
  // exists because migrations take a session-level advisory lock and run DDL
  // in a transaction that must outlive a single statement; through a
  // transaction pooler that lock is taken on a connection the pooler may hand
  // to someone else, so `migrate deploy` hangs or fails. Prisma Client never
  // reads this at runtime.
  //
  // ⚠️ Do NOT point `directUrl` at Supabase's "Direct connection" host
  // (`db.<ref>.supabase.co`). On the free plan that host is IPv6-only, and
  // GitHub Actions runners are IPv4-only — it works on a laptop and then
  // fails in CI at T58. The session pooler is the IPv4-reachable equivalent.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Consumers
// ---------------------------------------------------------------------------

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  // T31b — AES-256-GCM ciphertext, NOT a phone number. Never query this
  // column for equality; a random IV means the same number encrypts
  // differently every time. Look up via `phoneFingerprint` instead, and
  // decrypt with `decryptPii()` on the way out. See common/pii-crypto.ts.
  phone            String?
  // Keyed HMAC-SHA256 blind index over the normalised number. Carries the
  // uniqueness this column used to hold, and is what makes lookup-by-phone
  // still possible. NULL when the user gave no phone — Postgres treats NULLs
  // as distinct under a unique index, so many users may have none.
  phoneFingerprint String?   @unique
  name             String
  passwordHash     String
  /// T77 — flip this to ADMIN or OWNER (in the Supabase table editor, or from
  /// the admin panel) and a matching `Admin` row appears automatically; flip it
  /// back to CONSUMER and it is removed. The syncing is done by DATABASE
  /// TRIGGERS defined in migration 20260827020000_user_role_sync_admin, not by
  /// application code — see that file before changing anything here.
  ///
  /// Being an admin does not stop someone being a customer: their visits,
  /// bookings and points stay on this row.
  role             UserRole  @default(CONSUMER)
  emailVerifiedAt  DateTime?
  createdAt        DateTime  @default(now())

  visits      Visit[]
  redemptions Redemption[]
  bookings    Booking[]
  devices     DeviceToken[]
}

/// T77 — the one control that grants or removes admin access.
///
/// Deliberately the SAME two admin tiers as AdminRole plus CONSUMER, so the
/// value maps across one-to-one and a person reading either table sees the
/// same words. CONSUMER means "not an admin".
enum UserRole {
  CONSUMER
  ADMIN
  OWNER
}

// ---------------------------------------------------------------------------
// Merchants & subscription billing
// ---------------------------------------------------------------------------

model Merchant {
  id               String         @id @default(cuid())
  businessName     String
  email            String         @unique
  passwordHash     String
  status           MerchantStatus @default(PENDING)
  emailVerifiedAt  DateTime?
  stripeCustomerId String?        @unique
  foundingMember   Boolean        @default(false) // true for the first 50 signups — gets an extra free month
  /// T83 — how many clients this salon can serve AT ONCE: chairs, stations,
  /// stylists on shift. Availability treated every salon as a single resource
  /// until now, so a four-chair salon read as fully booked the moment ONE
  /// client booked.
  ///
  /// Default 1 is the old behaviour exactly, so every existing salon keeps
  /// working unchanged until someone sets a real number.
  seats            Int       @default(1)

  /// M1 (mobile spec W2/W5, R3.11) — the salon's logo, as served to EVERY
  /// Glow+ surface from one place. The bytes live in `MerchantLogo` (a side
  /// table, so a directory query never drags an image through Postgres); these
  /// two columns are the metadata the directory needs to build a stable,
  /// cache-bustable URL without joining to it.
  ///
  /// Both are NULL until the salon uploads one, which is what the app reads to
  /// decide between the real logo and its neutral placeholder (R3.12).
  logoMimeType     String?
  logoUpdatedAt    DateTime?

  /// M1 (mobile spec R3.6-R3.10) — where the salon actually is.
  ///
  /// Every field is optional and stays that way: the spec's own dependency
  /// note says a salon without a registered location must be handled
  /// gracefully rather than assumed to have one, so "no coordinates" has to be
  /// a representable state and not a migration that invents them.
  ///
  /// ⚠️ These are the SALON's coordinates, published deliberately. The
  /// CUSTOMER's location is never sent here and has no column anywhere in this
  /// schema — NF6 forbids storing it, and distance is therefore computed
  /// on-device from these numbers. Do not add a `lastKnownUserLocation`.
  addressLine      String?
  city             String?
  region           String?
  postalCode       String?
  latitude         Float?
  longitude        Float?

  createdAt        DateTime       @default(now())

  logo          MerchantLogo?
  subscription  Subscription?
  styles        Style[]
  rewardRules   RewardRule[]
  visits        Visit[]
  staff         MerchantStaff[]
  staffInvites  StaffInvite[]
  businessHours BusinessHours[]
  bookings      Booking[]
}

enum MerchantStatus {
  PENDING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

model MerchantStaff {
  id           String    @id @default(cuid())
  merchantId   String
  merchant     Merchant  @relation(fields: [merchantId], references: [id])
  email        String    @unique
  name         String? // captured on the invite / when the invite is accepted (T24)
  passwordHash String
  role         StaffRole @default(STAFF)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([merchantId])
}

/// A pending staff invitation (T24). Kept separate from MerchantStaff for the
/// same reason EmailVerification and PasswordReset are separate tables: the
/// row holds a hashed, single-use, expiring token, and no staff account (and
/// therefore no password hash) exists until the invite is accepted.
model StaffInvite {
  id         String    @id @default(cuid())
  merchantId String
  merchant   Merchant  @relation(fields: [merchantId], references: [id])
  email      String
  name       String?
  role       StaffRole @default(STAFF)
  token      String    @unique // random, single-use, hashed at rest
  expiresAt  DateTime // 7d — an invite is not a live credential, unlike a password reset
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([merchantId])
}

enum StaffRole {
  OWNER
  STAFF
}

model Subscription {
  id                   String    @id @default(cuid())
  merchantId           String    @unique
  merchant             Merchant  @relation(fields: [merchantId], references: [id])
  stripeSubscriptionId String    @unique
  plan                 Plan      @default(MONTHLY)
  priceCents           Int // 4999 ($49.99/mo) or 47999 ($479.99/yr)
  status               SubStatus
  trialStart           DateTime?
  trialEnd             DateTime?
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
}

enum SubStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum Plan {
  MONTHLY // $49.99/mo
  ANNUAL // $479.99/yr (~20% off monthly)
}

// ---------------------------------------------------------------------------
// Style catalog (salon-owned)
// ---------------------------------------------------------------------------

model Style {
  id              String    @id @default(cuid())
  merchantId      String
  merchant        Merchant  @relation(fields: [merchantId], references: [id])
  type            StyleType
  name            String // "Balayage", "French Tip Gel", "Deep Tissue Massage"
  pointsPerVisit  Int
  durationMinutes Int       @default(30) // used to calculate booking time slots
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())

  visits      Visit[]
  rewardRules RewardRule[]
  bookings    Booking[]
}

enum StyleType {
  HAIR
  NAIL
  SPA
  OTHER
}

// ---------------------------------------------------------------------------
// Visits — one earn event per completed style
// ---------------------------------------------------------------------------

model Visit {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  merchantId   String
  merchant     Merchant @relation(fields: [merchantId], references: [id])
  styleId      String
  style        Style    @relation(fields: [styleId], references: [id])
  pointsEarned Int // snapshot of style.pointsPerVisit at time of visit
  loggedBy     String // staff user id
  visitDate    DateTime @default(now())
  bookingId    String?  @unique // set when the visit came from a completed booking
  booking      Booking? @relation(fields: [bookingId], references: [id])

  // Points expiry (T25) [F8]. Points are not stored as a running balance —
  // they are derived from these rows — so expiring points means excluding a
  // visit from progress maths, never deleting it. The visit stays in the
  // merchant's history; only its points stop counting.
  expired   Boolean   @default(false)
  expiredAt DateTime?

  @@index([userId, merchantId, expired])
  @@index([expired, visitDate])
}

// ---------------------------------------------------------------------------
// Reward rules — salon-defined discount triggers
// ---------------------------------------------------------------------------

model RewardRule {
  id                 String      @id @default(cuid())
  merchantId         String
  merchant           Merchant    @relation(fields: [merchantId], references: [id])
  name               String // "Loyal Client Discount", "Free Gel Mani"
  triggerType        TriggerType
  triggerValue       Int // e.g. 5 (visits) or 200 (points)
  styleScopeId       String? // optional: restrict to one style/type
  styleScope         Style?      @relation(fields: [styleScopeId], references: [id])
  rewardType         RewardType
  rewardValue        Int // 15 (%) or 2000 (cents) — or a styleId for FREE_SERVICE, stored in freeServiceStyleId
  freeServiceStyleId String?
  oneTime            Boolean     @default(false)
  active             Boolean     @default(true)
  createdAt          DateTime    @default(now())

  redemptions Redemption[]
}

enum TriggerType {
  VISIT_COUNT
  POINTS_THRESHOLD
}

enum RewardType {
  PERCENT_OFF
  FLAT_DISCOUNT
  FREE_SERVICE
}

model Redemption {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  rewardRuleId String
  rewardRule   RewardRule @relation(fields: [rewardRuleId], references: [id])
  redeemedAt   DateTime   @default(now())
}

// ---------------------------------------------------------------------------
// Admin accounts — T22 [F7]. Not self-service: there is still no signup route,
// and there must not be one. T77 adds the two supported ways to gain an admin
// account, both of which require an existing OWNER or direct database access:
// an OWNER creates one from the panel, or an operator inserts a row directly.
// ---------------------------------------------------------------------------

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         AdminRole @default(OWNER)
  createdAt    DateTime  @default(now())
}

/// T77 — Two tiers, because "any admin can mint an admin" makes one stolen
/// admin session a permanent, self-replicating foothold: the attacker creates
/// a second account and revoking the first changes nothing. Only an OWNER may
/// create, promote or delete admins; an ADMIN does the day-to-day work of
/// approving and suspending salons.
///
/// The default is deliberately the WEAKER role, so that a row inserted by hand
/// in a database console cannot silently grant the strongest privilege in the
/// platform. An operator who wants an OWNER has to say so explicitly.
enum AdminRole {
  OWNER
  ADMIN
}

// ---------------------------------------------------------------------------
// Email verification (consumer, merchant, admin)
// ---------------------------------------------------------------------------

model EmailVerification {
  id          String      @id @default(cuid())
  accountId   String // userId, merchantId, or adminId
  accountType AccountType
  email       String
  token       String      @unique // random, single-use, hashed at rest
  expiresAt   DateTime // typically now + 24h
  verifiedAt  DateTime?
  createdAt   DateTime    @default(now())
}

// ---------------------------------------------------------------------------
// Password reset (consumer, merchant) — T21 [F5]
// ---------------------------------------------------------------------------

model PasswordReset {
  id          String      @id @default(cuid())
  accountId   String // userId or merchantId
  accountType AccountType
  email       String
  token       String      @unique // random, single-use, hashed at rest
  expiresAt   DateTime // 1h — shorter than email verification, it's a live credential reset
  usedAt      DateTime?
  createdAt   DateTime    @default(now())
}

enum AccountType {
  CONSUMER
  MERCHANT
  ADMIN
  // T47 — MerchantStaff rows are a fourth kind of account that can hold a
  // session, and RefreshToken has to be able to name one. Additive: nothing
  // reading EmailVerification or PasswordReset can be handed a STAFF row,
  // because nothing writes one.
  STAFF
}

// ---------------------------------------------------------------------------
// Refresh tokens — T47 [F12]
//
// The access token is short-lived now (15 minutes, jwt.util.ts) and is not
// stored anywhere; this table is the long-lived half, and it is the only part
// of a session the server can actually revoke.
//
// Three things about the shape are deliberate:
//
//   `token` is the SHA-256 of the value handed to the client, never the value
//   itself — same treatment as EmailVerification and PasswordReset. A dump of
//   this table must not be a set of working sessions.
//
//   `accountId` + `accountType` are stored instead of the JWT claims. Refresh
//   RE-DERIVES `role` and `merchantId` from the account's own row every time,
//   so a staff member demoted from OWNER to STAFF loses the owner claims on
//   their next refresh instead of keeping them for the life of the token.
//   Freezing the claims here would have quietly undone T24's owner/staff split.
//
//   `familyId` is the rotation lineage. Each refresh mints a replacement and
//   marks the old row `usedAt`; presenting an already-used token means the
//   value leaked and is being replayed, so the WHOLE family is revoked rather
//   than just that row (OAuth 2.0 Security BCP §4.14.2). The legitimate holder
//   is logged out too — that is the intended outcome, not a side effect.
// ---------------------------------------------------------------------------

model RefreshToken {
  id          String      @id @default(cuid())
  token       String      @unique // sha256 of the raw token, hashed at rest
  accountId   String
  accountType AccountType
  familyId    String // rotation lineage; reuse revokes every row sharing it
  expiresAt   DateTime // 30 days
  usedAt      DateTime? // set when rotated — a second use is a replay
  revokedAt   DateTime? // logout, password reset, or a detected replay
  createdAt   DateTime    @default(now())

  @@index([accountId, accountType])
  @@index([familyId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Business hours — one row per weekday per merchant. dayOfWeek 0 = Sunday.
// The @@unique is required: availability.service.ts looks rows up by the
// compound key `merchantId_dayOfWeek`.
// ---------------------------------------------------------------------------

model BusinessHours {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  dayOfWeek  Int // 0 (Sunday) .. 6 (Saturday)
  openTime   String // "09:00", 24h format
  closeTime  String // "17:00"
  closed     Boolean  @default(false)

  @@unique([merchantId, dayOfWeek])
}

// ---------------------------------------------------------------------------
// Bookings — appointment slots. Deliberately single-resource per merchant
// for v1 (see availability.service.ts): no staff/room concurrency yet, so a
// merchant can only have one booking at a time regardless of how many
// stylists they have. Fine for a single-chair salon; a multi-stylist salon
// would under-report availability.
// ---------------------------------------------------------------------------

model Booking {
  id         String        @id @default(cuid())
  merchantId String
  merchant   Merchant      @relation(fields: [merchantId], references: [id])
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  styleId    String
  style      Style         @relation(fields: [styleId], references: [id])
  startTime  DateTime
  endTime    DateTime
  status     BookingStatus @default(PENDING)
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  visit Visit?
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

// ---------------------------------------------------------------------------
// Mobile-app support  (M1)
// ---------------------------------------------------------------------------

/// The bytes of a salon's logo.
///
/// A SIDE TABLE, not a column on Merchant, and that is the whole design. The
/// public directory selects a handful of Merchant columns for up to 100 salons
/// on every unauthenticated load; a `Bytes` column on that row would be read
/// off disk with them whether or not it was selected in a given query, and one
/// careless `include` would put 100 images into a JSON response. Here, the
/// image can only be fetched by asking for it by id — which is exactly what
/// `GET /merchants/:id/logo` does, one salon at a time, with cache headers.
///
/// Stored in Postgres rather than object storage because the platform has no
/// object storage and adding a vendor to serve one small image per salon would
/// be a new secret, a new failure mode and a new bill. The size ceiling
/// (MAX_LOGO_BYTES) is what keeps that honest.
model MerchantLogo {
  merchantId String   @id
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  mimeType   String
  bytes      Bytes
  sizeBytes  Int
  updatedAt  DateTime @updatedAt
}

/// An Expo push token for one installation of the mobile app  (R4.5).
///
/// Keyed on the token, not on (user, device): a reinstall issues a new token,
/// and the same physical device can be handed between accounts. `userId` is
/// therefore updated on conflict rather than duplicated, so a phone that signs
/// into a second account stops receiving the first account's notifications —
/// the alternative leaks one customer's appointment status to another.
///
/// `revokedAt` rather than a delete on logout, so a token Expo later reports
/// as dead can be tombstoned by the sender without racing the client.
model DeviceToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String    @unique
  platform   String    @default("unknown")
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @updatedAt

  @@index([userId])
}
