generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  phone             String?
  phoneFingerprint  String?   @unique
  name              String
  passwordHash      String
  emailVerifiedAt   DateTime?
  createdAt         DateTime  @default(now())

  visits            Visit[]
  bookings          Booking[]
}

model EmailVerification {
  id          String       @id @default(cuid())
  accountId   String
  accountType AccountType
  email       String
  token       String       @unique
  expiresAt   DateTime
  verifiedAt  DateTime?
  createdAt   DateTime     @default(now())
}

enum AccountType {
  CONSUMER
  MERCHANT
  ADMIN
}

model Merchant {
  id                String            @id @default(cuid())
  businessName      String
  email             String            @unique
  passwordHash      String
  status            MerchantStatus    @default(PENDING)
  emailVerifiedAt   DateTime?
  stripeCustomerId  String?           @unique
  foundingBadge     Boolean           @default(false)
  createdAt         DateTime          @default(now())

  styles            Style[]
  visits            Visit[]
  businessHours     BusinessHours[]
  bookings          Booking[]
}

enum MerchantStatus {
  PENDING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Style catalog (salon-owned)
// ---------------------------------------------------------------------------

model Style {
  id              String     @id @default(cuid())
  merchantId      String
  merchant        Merchant   @relation(fields: [merchantId], references: [id])
  type            StyleType
  name            String
  pointsPerVisit  Int
  durationMinutes Int        @default(30) // used to calculate booking time slots
  active          Boolean    @default(true)
  createdAt       DateTime   @default(now())

  visits          Visit[]
  bookings        Booking[]
}

enum StyleType {
  HAIR
  NAIL
  SPA
  OTHER
}

// ---------------------------------------------------------------------------
// Visits — one earn event per completed style. bookingId links back to the
// booking that generated it, when a visit came from a completed booking
// rather than being logged manually at the front desk.
// ---------------------------------------------------------------------------

model Visit {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  merchantId   String
  merchant     Merchant  @relation(fields: [merchantId], references: [id])
  styleId      String
  style        Style     @relation(fields: [styleId], references: [id])
  pointsEarned Int
  loggedBy     String
  visitDate    DateTime  @default(now())
  bookingId    String?   @unique
  booking      Booking?  @relation(fields: [bookingId], references: [id])
}

// ---------------------------------------------------------------------------
// Business hours — one row per weekday per merchant. dayOfWeek 0 = Sunday.
// ---------------------------------------------------------------------------

model BusinessHours {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  dayOfWeek  Int      // 0 (Sunday) .. 6 (Saturday)
  openTime   String   // "09:00", 24h format
  closeTime  String   // "17:00"
  closed     Boolean  @default(false)

  @@unique([merchantId, dayOfWeek])
}

// ---------------------------------------------------------------------------
// Bookings — appointment slots. Deliberately single-resource per merchant
// for v1 (see availability.service.ts note): no staff/room concurrency yet,
// so a merchant can only have one booking at a time regardless of how many
// stylists they actually have. Good enough for a single-chair salon; a
// multi-stylist salon would double-book customers into the same slot.
// ---------------------------------------------------------------------------

model Booking {
  id         String        @id @default(cuid())
  merchantId String
  merchant   Merchant      @relation(fields: [merchantId], references: [id])
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  styleId    String
  style      Style         @relation(fields: [styleId], references: [id])
  startTime  DateTime
  endTime    DateTime
  status     BookingStatus @default(PENDING)
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  visit      Visit?
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

// ---------------------------------------------------------------------------
// Reward rules — salon-defined discount triggers
// ---------------------------------------------------------------------------

model RewardRule {
  id            String       @id @default(cuid())
  merchantId    String
  name          String
  triggerType   TriggerType
  triggerValue  Int
  styleScopeId  String?
  rewardType    RewardType
  rewardValue   Int
  oneTime       Boolean      @default(false)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())

  redemptions   Redemption[]
}

enum TriggerType {
  VISIT_COUNT
  POINTS_THRESHOLD
}

enum RewardType {
  PERCENT_OFF
  FLAT_DISCOUNT
  FREE_SERVICE
}

model Redemption {
  id           String     @id @default(cuid())
  userId       String
  rewardRuleId String
  rewardRule   RewardRule @relation(fields: [rewardRuleId], references: [id])
  redeemedAt   DateTime   @default(now())
}
